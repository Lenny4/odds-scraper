{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      // "dom" is needed for the callbacks executed in the browser by puppeteer (page.evaluate)
      "dom"
    ],
    // keep the pre-ES2022 class fields semantics: subclasses redeclare fields like `app!: App`
    // which would otherwise be reset to undefined after super()
    "useDefineForClassFields": false,
    "module": "commonjs",
    "rootDir": "src",
    "outDir": "build",
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    // Next.js app has its own tsconfig
    "src/Front/React",
    // run by vitest, not shipped in build/
    "src/**/__tests__"
  ]
}
